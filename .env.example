# Placeholder only. make configure creates an ignored .env with a random password.
NEO4J_PASSWORD=REPLACE_WITH_A_RANDOM_LOCAL_PASSWORD
# Leave unset to disable HTTP import; make configure-auth generates a local token.
CORPUS_IMPORT_TOKEN=
# Optional bounded agent settings; Compose supplies these defaults.
AGENT_MAX_CALLS=6
AGENT_SELECTION_RETRIES=1
AGENT_TIMEOUT=180
AGENT_MODEL_TIMEOUT=45
AGENT_QUERY_TIMEOUT=5
AGENT_CONTEXT_CHARS=6500
